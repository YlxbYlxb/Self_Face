# Caddy 配置：HTTPS 证书的自动申请与续期，并按路径分发流量。
#
# 只在 `docker compose --profile tls up -d` 时生效，备案期间不需要这个容器。
# 站点域名来自 compose 传入的 APP_DOMAIN（写在 .env 里）。
#
# ── 为什么 /api 直连 backend，而不是绕经 frontend 的 nginx ──
# 每多经过一层代理，后端拿到的客户端 IP 就更可能变成「网关地址」而不是真实用户，
# 而后端限流是按 IP 计数的 —— 一旦全站都被算成同一个来源，正常用户会被误伤。
# 这里让接口少走一跳，并显式写入 X-Real-IP，链路最短也最不容易出错。

{$APP_DOMAIN:localhost} {
	# 前端 nginx 里也开了 gzip，重复配置无害：
	# Caddy 会跳过已经压过的响应，不会压两遍
	encode gzip

	# 证书签发、续期失败都会打到这里。域名切过来之后打不开，
	# 第一件事就是 `docker compose logs caddy` 看这个日志
	log {
		output stdout
		format console
	}

	handle /api/* {
		reverse_proxy backend:8081 {
			# 后端优先读 X-Real-IP（见 RateLimitInterceptor#clientIp）。
			# header_up 是覆盖语义，客户端自己带的同名头会被丢掉，伪造不了。
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		reverse_proxy frontend:80
	}
}
