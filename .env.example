# 复制成 .env 后填写。.env 已被 .gitignore 忽略，不要提交到仓库。
#   cp .env.example .env
#
# 生成随机密钥（Git Bash / Linux / macOS 都可用）：
#   openssl rand -base64 48

# ===== 必填三项：缺任意一项 docker compose 都会拒绝启动 =====

# MySQL root 密码
MYSQL_ROOT_PASSWORD=

# JWT 签名密钥。这个值已写进开源仓库的话，任何人都能伪造登录态，务必换掉
JWT_SECRET=

# 用户 LLM API Key 的加密密钥。
# ⚠️ 一旦投入使用就不要随意修改：换掉之后库里已存的 Key 会解不开，
#    用户需要到「设置」页重新填写自己的 Key。
APP_CRYPTO_KEY=

# ===== 可选 =====

# 数据库名
DB_NAME=selfface

# 前端对外端口（宿主机 8080 常被占用，默认 8090）
WEB_PORT=8090

# 宿主机暴露 MySQL 的端口，避免与本地已装的 3306 冲突
MYSQL_EXPOSED_PORT=3307

# 若前端不在同一域名下，在这里补上允许的跨域来源，逗号分隔
# CORS_ALLOWED_ORIGINS=https://your-domain.com
