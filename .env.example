# SelfFace 环境变量样例。复制成 .env 后填写：
#   cp .env.example .env
#
# .env 已被 .gitignore 忽略，不要提交到仓库。
# 用 deploy/deploy.sh 部署的话这一步会自动完成，不用手工填。
#
# 生成随机密钥（Git Bash / Linux / macOS / 服务器都可用）：
#   openssl rand -hex 32

# ===== 必填三项：缺任意一项 docker compose 都会拒绝启动 =====

# MySQL root 密码
MYSQL_ROOT_PASSWORD=

# JWT 签名密钥，不能少于 32 字节。
# 下面这个内置值已经写进开源仓库，任何拿到仓库的人都能伪造登录态，部署时务必换掉
JWT_SECRET=

# 用户 LLM API Key 的加密密钥（AES-256-GCM）。
# ⚠️ 一旦投入使用就不要随意修改：换掉之后库里已存的 Key 会解不开，
#    用户需要到「设置」页重新填写自己的 Key。
APP_CRYPTO_KEY=

# ===== 常用可选项 =====

# 数据库名
DB_NAME=selfface

# 前端对外端口（宿主机 8080 常被占用，默认 8090）
WEB_PORT=8090

# 站点域名。只在启用 HTTPS（--profile tls）时需要。
# 备案通过、域名解析到本机之后再填，例如 example.com（不要带 http:// 和路径）
APP_DOMAIN=

# ICP 备案号，备案通过后由工信部/云厂商下发，形如「京ICP备2026000000号-1」。
# 填了会展示在页面底部并链接到工信部备案系统；留空则不显示。
# 这是构建期变量，改完必须重新构建前端才生效：docker compose up -d --build frontend
ICP_BEIAN=

# ===== 构建加速（国内服务器建议打开）=====
# 直连官方源在国内经常慢到超时。需要时取消注释即可：
# MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
# NPM_REGISTRY=https://registry.npmmirror.com

# ===== 其他 =====

# 宿主机暴露 MySQL 的端口。默认不暴露（见 docker-compose.yml 里的说明），
# 只有临时取消那段注释、需要从宿主机连数据库排查时才用得上
MYSQL_EXPOSED_PORT=3307

# 若前端不在同一域名下，在这里补上允许的跨域来源，逗号分隔
# CORS_ALLOWED_ORIGINS=https://your-domain.com
